# ── Backend ────────────────────────────────────────────────────────────────────
# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=4000
# Public URL of the backend (used for links/receipts; not for WebAuthn).
BASE_URL=http://localhost:4000
# Origin the frontend is served from. WebAuthn's expectedOrigin; the RP ID is its hostname.
# Must match the URL in the browser exactly (scheme, host, port) or every passkey call fails.
FRONTEND_ORIGIN=http://localhost:5173

# ── Payments (Razorpay test mode) ──────────────────────────────────────────────
# From https://dashboard.razorpay.com → Settings → API Keys (use rzp_test_… keys).
# Leave both empty to use the built-in mock provider (order_mock_… ids) for offline demos.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Shopping agent ─────────────────────────────────────────────────────────────
# Optional. With a key the agent is a real tool-using LLM; without it a deterministic
# scripted agent reproduces the same hijack so the demo never depends on network or quota.
OPENAI_API_KEY=
# Model for the LLM agent (any chat model with function calling).
OPENAI_MODEL=gpt-4o-mini
# auto = llm if OPENAI_API_KEY is set, else scripted · scripted · llm
AGENT_MODE=auto

# ── Runtime ────────────────────────────────────────────────────────────────────
# Set to "production" to disable the /api/dev/* endpoints (tamper, reset).
NODE_ENV=development
