RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PORT=4000
BASE_URL=http://localhost:4000
# Origin the frontend is served from (WebAuthn expectedOrigin); rpID is derived from its hostname
FRONTEND_ORIGIN=http://localhost:5173
# Optional: enables the real LLM shopping agent. Unset → deterministic scripted agent (offline demo safe).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# auto | scripted | llm
AGENT_MODE=auto
